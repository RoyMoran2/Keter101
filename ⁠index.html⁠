    <script>
        lucide.createIcons();

        function switchAuthTab(tab) {
            const btnLogin = document.getElementById('tab-login');
            const btnReg = document.getElementById('tab-register');
            const formLogin = document.getElementById('form-login');
            const formReg = document.getElementById('form-register');

            if (tab === 'login') {
                btnLogin.className = "flex-1 py-2.5 text-sm font-bold rounded-lg transition-all bg-red-700 text-white shadow-md";
                btnReg.className = "flex-1 py-2.5 text-sm font-bold rounded-lg transition-all text-zinc-400 hover:text-zinc-200";
                formLogin.classList.remove('hidden');
                formReg.classList.add('hidden');
            } else {
                btnReg.className = "flex-1 py-2.5 text-sm font-bold rounded-lg transition-all bg-red-700 text-white shadow-md";
                btnLogin.className = "flex-1 py-2.5 text-sm font-bold rounded-lg transition-all text-zinc-400 hover:text-zinc-200";
                formReg.classList.remove('hidden');
                formLogin.classList.add('hidden');
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const personalId = document.getElementById('login-id').value;
            if (!personalId) return;

            document.getElementById('auth-view').classList.add('hidden');
            document.getElementById('soldier-dashboard').classList.remove('hidden');
            document.getElementById('user-name-display').innerText = 'לוחם #' + personalId;
            initChart();
        }

        function handleRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value;
            const team = document.getElementById('reg-team').value;

            document.getElementById('auth-view').classList.add('hidden');
            document.getElementById('soldier-dashboard').classList.remove('hidden');
            document.getElementById('user-name-display').innerText = name;
            document.getElementById('user-team-badge').innerText = team;
            initChart();
        }

        function switchSoldierTab(tab) {
            const btnTasks = document.getElementById('btn-tasks');
            const btnMetrics = document.getElementById('btn-metrics');
            const viewTasks = document.getElementById('soldier-tab-tasks');
            const viewMetrics = document.getElementById('soldier-tab-metrics');

            if (tab === 'tasks') {
                btnTasks.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-red-700 text-white";
                btnMetrics.className = "flex-1 py-2 text-xs font-bold rounded-lg text-zinc-400";
                viewTasks.classList.remove('hidden');
                viewMetrics.classList.add('hidden');
            } else {
                btnMetrics.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-red-700 text-white";
                btnTasks.className = "flex-1 py-2 text-xs font-bold rounded-lg text-zinc-400";
                viewMetrics.classList.remove('hidden');
                viewTasks.classList.add('hidden');
            }
        }

        function toggleTask(btn) {
            const icon = btn.querySelector('i');
            if (icon.classList.contains('opacity-0')) {
                icon.classList.remove('opacity-0');
                btn.classList.add('bg-red-600', 'border-red-600', 'text-white');
            } else {
                icon.classList.add('opacity-0');
                btn.classList.remove('bg-red-600', 'border-red-600', 'text-white');
            }
        }

        function openAdminModal() {
            document.getElementById('admin-modal').classList.remove('hidden');
            document.getElementById('admin-passcode').focus();
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
            document.getElementById('admin-passcode').value = '';
        }

        function verifyAdminCode() {
            const code = document.getElementById('admin-passcode').value;
            if (code === '1010') {
                closeAdminModal();
                document.getElementById('auth-view').classList.add('hidden');
                document.getElementById('admin-dashboard').classList.remove('hidden');
            } else {
                alert('קוד גישה שגוי!');
            }
        }

        function logout() {
            document.getElementById('soldier-dashboard').classList.add('hidden');
            document.getElementById('admin-dashboard').classList.add('hidden');
            document.getElementById('auth-view').classList.remove('hidden');
        }

        function exportToCSV() {
            const data = [
                ["שם מלא", "מספר אישי", "צוות", "ניקוד בראור", "סטטוס משימות"],
                ["דניאל כהן", "9412873", "צוות חוד", "88", "100%"],
                ["רועי מורן", "8392019", "צוות חוד", "94", "100%"],
                ["עומרי לוי", "7584920", "צוות אתק", "82", "85%"],
                ["איתי גולן", "6493021", "צוות רתק", "90", "90%"]
            ];

            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            data.forEach(row => { csvContent += row.join(",") + "\n"; });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "דוח_כשירות_גדוד_101.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        let chartInstance = null;
        function initChart() {
            const ctx = document.getElementById('fitnessChart');
            if (!ctx) return;
            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['חודש 1', 'חודש 2', 'חודש 3', 'נוכחי'],
                    datasets: [{
                        label: 'ציון בראור',
                        data: [72, 78, 83, 88],
                        borderColor: '#dc2626',
                        backgroundColor: 'rgba(220, 38, 38, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: '#27272a' }, ticks: { color: '#a1a1aa', font: { size: 10 } } },
                        y: { grid: { color: '#27272a' }, ticks: { color: '#a1a1aa', font: { size: 10 } } }
                    }
                }
            });
        }
    </script>
</body>
